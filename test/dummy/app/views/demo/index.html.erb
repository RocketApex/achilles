<main class="demo-page">
  <section class="demo-panel">
    <p class="demo-kicker">Achilles demo</p>
    <h1>Counter component</h1>
    <p>
      This page is rendered by the dummy Rails app. Achilles registers the
      component below from its <code>data-component-class</code> attribute.
    </p>

    <button id="demo-counter" class="demo-counter" data-component-class="DemoCounterComponent" type="button">
      Count: <span data-count>0</span>
    </button>

    <p>
      <%= link_to "Open nested demo", nested_path, id: "open-nested-demo" %>
    </p>
  </section>
</main>
